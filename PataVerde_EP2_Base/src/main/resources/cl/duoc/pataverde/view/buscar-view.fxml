<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cl.duoc.pataverde.controller.BuscarController"
      spacing="12">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="BÚSQUEDA DE MASCOTAS"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label text="Filtrar por tipo de mascota:"/>

    <HBox spacing="10">

        <Button fx:id="btnTodos"
                text="Todos"
                onAction="#filtrarTodos"/>

        <Button fx:id="btnPerro"
                text="Perro"
                onAction="#filtrarPerros"/>

        <Button fx:id="btnGato"
                text="Gato"
                onAction="#filtrarGatos"/>

    </HBox>

    <Label text="Buscar por nombre:"/>

    <TextField fx:id="txtBuscar"
               promptText="Escribe el nombre de la mascota..."/>

    <TableView fx:id="tablaBusqueda" VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="colTipo"
                         text="Tipo"
                         prefWidth="100"/>

            <TableColumn fx:id="colNombre"
                         text="Nombre"
                         prefWidth="130"/>

            <TableColumn fx:id="colEdad"
                         text="Edad"
                         prefWidth="70"/>

            <TableColumn fx:id="colPeso"
                         text="Peso (kg)"
                         prefWidth="90"/>

            <TableColumn fx:id="colCosto"
                         text="Costo consulta"
                         prefWidth="130"/>

        </columns>

    </TableView>

</VBox>
